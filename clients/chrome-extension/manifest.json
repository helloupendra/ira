{
  "manifest_version": 3,
  "name": "Ira for Chrome",
  "short_name": "Ira",
  "version": "0.3.0",
  "description": "Lets your own Ira read and watch a Chrome tab when you ask. Talks only to the Ira companion on this Mac.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ira for Chrome",
    "default_popup": "popup.html"
  }
}
