<?xml version="1.0" encoding="utf-8"?>
<!-- Play Lite: the Google Play build without SMS and the call log, so no Permissions
     Declaration review stands between it and production. The tools that need them are
     not offered either (Flavor.PLAY_LITE); scripts/check-permissions.sh checks the result. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALL_LOG" tools:node="remove"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission android:name="android.permission.READ_SMS" tools:node="remove"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-permission android:name="android.permission.SEND_SMS" tools:node="remove"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />
</manifest>
