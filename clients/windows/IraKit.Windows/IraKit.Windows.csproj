<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything Ira for Windows does that needs no window: the server address, pairing,
       the device key, the device connection, asking and answering actions, and the tools
       Ira uses on the PC. Tested on its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IraKit</RootNamespace>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IraKit.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI Automation (System.Windows.Automation), for browser tabs. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <!-- PDF text, and Windows Search through its OLE DB provider. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.14" />
  </ItemGroup>

</Project>
