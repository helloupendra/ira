<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything Ira for Windows does that needs no window: the server address, pairing,
       the device key, the device connection, asking and answering actions. Tested on its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IraKit</RootNamespace>
    <Version>0.1.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IraKit.Windows.Tests" />
  </ItemGroup>

</Project>
