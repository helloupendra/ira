# ${name} for ${business}. Made by `ira init` on ${date}.
#
# No secrets in this file. Each key is named by an environment variable (an
# *_env setting), set in the service's environment or in a .env file next to
# this one (chmod 600). On AWS the server's role signs Bedrock and Polly calls,
# so there is no key at all. Every option: ira.example.yaml in the repository.
#
# Check this folder with `ira doctor` (`ira doctor --no-models` makes no calls).

assistant:
  name: ${name_yaml}  # can be changed later from the console
  business: ${business_yaml}
  instructions: |
${instructions}
  tier: default                   # the model chain that answers chat

data_dir: ./data                  # ira.db and your tools' files; back it up

${tools_section}

${provider_sections}

channels:
  http:
    host: 127.0.0.1               # reached through a tunnel or a TLS proxy
    port: ${port}
    # The address people open, for the links Ira prints and sends (the setup
    # link, invitations). IRA_PUBLIC_URL in the environment wins.
${public_url_line}
  telegram:
    enabled: false
    token_env: TELEGRAM_BOT_TOKEN

actions:
  expiry_seconds: 120
  # Who may confirm an action with their own PIN (viewers never can).
  confirm_roles: [owner, admin, staff]
${search_section}
