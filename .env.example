# Copy to .env (gitignored) and fill in only what your ira.yaml uses.
# Placeholders only: never commit a real value.

OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=replace-me
# Web search (each person switches it on for themselves): a Brave Search API key.
BRAVE_SEARCH_API_KEY=replace-me

# Amazon Bedrock and Polly use the default AWS credential chain
# (environment, ~/.aws profile, SSO, or an instance role). Prefer a role.
# AWS_PROFILE=replace-me
# AWS_REGION=us-east-1

# Optional: a different config file, and the private deny-list used by the
# pre-commit hook (kept outside the repository).
# IRA_CONFIG=./ira.yaml
# IRA_DENYLIST=~/.config/ira/denylist.txt
